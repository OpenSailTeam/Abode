  {% unless is_product_modal %}
    <div class="product-inquiry-section">
      {% form 'contact' %}
        <div class="product-inquiry-card">
          <div class="product-inquiry__header">
            <p class="product-inquiry__title">Questions about this item?</p>
            <p class="product-inquiry__intro">
              Send us a quick note and our team will help with availability, dimensions, delivery, or any other
              concerns.
            </p>
          </div>

          {% assign has_message = false %}

          {% if form.errors != blank %}
            {% assign has_message = true %}
            {% assign message_type = 'error' %}
          {% endif %}

          {% if form.posted_successfully? %}
            {% assign has_message = true %}
            {% assign message_type = 'success' %}
          {% endif %}

          {% if has_message %}
            <div class="contact-message message--{{ message_type }}">
              {% case message_type %}
                {% when 'success' %}
                  <p>
                    {{ 'contact.form.post_success' | t }}
                  </p>
                {% when 'error' %}
                  {{ form.errors | default_errors }}
              {% endcase %}
            </div>
          {% endif %}

          <div class="form-fields-columns">
            <div class="form-field form-field--half">
              {% assign value = '' %}
              {%- if form.name -%}
                {% assign value = form.name %}
              {%- elsif customer -%}
                {% assign value = customer.name %}
              {%- endif -%}

              <input
                class="form-field-input form-field-text {% if form.errors contains 'name' %}form-field-error{% endif %}"
                id="product_inquiry_name"
                name="contact[name]"
                type="text"
                value="{{ value }}"
              >

              <label class="form-field-title" for="product_inquiry_name">
                {{ 'contact.form.name' | t }}
              </label>
            </div>

            <div class="form-field form-field--half">
              {% assign value = '' %}
              {%- if form.email -%}
                {% assign value = form.email %}
              {%- elsif customer -%}
                {% assign value = customer.email %}
              {%- endif %}
              <input
                class="form-field-input form-field-text {% if form.errors contains 'email' %}form-field-error{% endif %}"
                id="product_inquiry_email"
                name="contact[email]"
                type="text"
                value="{{ value }}"
                autocorrect="off"
                autocapitalize="off"
              >

              <label class="form-field-title" for="product_inquiry_email">
                {{ 'contact.form.email' | t }}
              </label>
            </div>
          </div>

          <div class="form-field">
            {% assign value = '' %}
            {%- if form.body -%}
              {% assign value = form.body %}
            {%- endif -%}
            <textarea
              class="form-field-input form-field-textarea product-inquiry__message {% if form.errors contains 'body' %}form-field-error{% endif %}"
              id="product_inquiry_message"
              name="contact[message]"
            >{{ value }}</textarea>

            <label class="form-field-title" for="product_inquiry_message">
              {{ 'contact.form.message' | t }}
            </label>
          </div>

          <input type="hidden" name="contact[Product]" value="{{ product.title | escape }}">
          <input type="hidden" data-product-inquiry-url name="contact[Product URL]" value="">

          <script>
            (function () {
              var inquiryForm = document.currentScript.closest('form');
              if (!inquiryForm) return;

              var filledClass = 'form-field-filled';
              var fieldSelector = '.form-field-input';

              function toggleFilled(event) {
                var field = event.currentTarget;
                field.classList.toggle(filledClass, field.value.length > 0);
              }

              inquiryForm.addEventListener('submit', function () {
                var productUrlInput = inquiryForm.querySelector('[data-product-inquiry-url]');
                if (productUrlInput) {
                  productUrlInput.value = document.documentURI;
                }
              });

              inquiryForm.querySelectorAll(fieldSelector).forEach(function (field) {
                field.classList.toggle(filledClass, field.value.length > 0);
                field.addEventListener('focus', toggleFilled);
                field.addEventListener('blur', toggleFilled);
                field.addEventListener('change', toggleFilled);
                field.addEventListener('input', toggleFilled);
              });
            })();
          </script>

          <div class="form-action-row">
            <button class="button-secondary product-inquiry__button" type="submit">Ask a question</button>
          </div>
        </div>
      {% endform %}

      {% assign contact_email_subject = product.title | append: ' Question' %}
      {% render 'contact-direct-options',
        extra_class: 'contact-direct-options--product-inquiry product-inquiry-direct',
        email_subject: contact_email_subject
      %}
    </div>
  {% endunless %}
{% endif %}
